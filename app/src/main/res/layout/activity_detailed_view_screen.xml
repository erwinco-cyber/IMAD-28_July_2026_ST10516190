<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#673AB7"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        tools:context=".Detailed_View_Screen">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Item Details"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginBottom="24dp"/>

        <EditText
            android:id="@+id/itemNameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:hint="Item Name"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:inputType="text"/>

        <EditText
            android:id="@+id/itemCategoryInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:hint="Category (e.g. Food, Drinks)"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:inputType="text"/>

        <EditText
            android:id="@+id/itemQuantityInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:hint="Quantity"
            android:inputType="number"
            android:padding="12dp"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/itemCommentsInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:hint="Comments"
            android:padding="12dp"
            android:layout_marginBottom="20dp"
            android:inputType="textMultiLine"/>

        <Button
            android:id="@+id/saveItemButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#CE9D0A"
            android:text="Add Item to List"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/displayItemsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#CE9D0A"
            android:text="Display All Items"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/itemsListDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#E1BEE7"
            android:padding="12dp"
            android:text="No items added yet."
            android:textColor="#000000"
            android:textSize="16sp"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Back to Main Screen"/>

    </LinearLayout>
</ScrollView>